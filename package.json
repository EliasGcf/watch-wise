{
  "name": "watch-wise",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "bun": "1.4.0"
  },
  "scripts": {
    "start": "bun bin/server.ts",
    "dev": "portless run bun --bun ace serve --watch",
    "test": "bun --bun --env-file=.env.test ./bin/test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit --project inertia/tsconfig.json",
    "vite:build": "bun --bun vite build",
    "generate:sdk": "bunx --bun @hey-api/openapi-ts",
    "db:reset": "bun --bun ace migration:fresh --seed"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.ts",
    "#exceptions/*": "./app/exceptions/*.ts",
    "#models/*": "./app/models/*.ts",
    "#mails/*": "./app/mails/*.ts",
    "#services/*": "./app/services/*.ts",
    "#listeners/*": "./app/listeners/*.ts",
    "#events/*": "./app/events/*.ts",
    "#generated/*": "./.adonisjs/server/*.ts",
    "#middleware/*": "./app/middleware/*.ts",
    "#transformers/*": "./app/transformers/*.ts",
    "#validators/*": "./app/validators/*.ts",
    "#providers/*": "./providers/*.ts",
    "#policies/*": "./app/policies/*.ts",
    "#abilities/*": "./app/abilities/*.ts",
    "#database/*": "./database/*.ts",
    "#decorators/*": "./app/decorators/*.ts",
    "#tests/*": "./tests/*.ts",
    "#start/*": "./start/*.ts",
    "#config/*": "./config/*.ts"
  },
  "devDependencies": {
    "@adonisjs/assembler": "8.4.0",
    "@adonisjs/eslint-config": "3.1.0",
    "@adonisjs/prettier-config": "1.5.0",
    "@adonisjs/tsconfig": "2.0.0",
    "@hey-api/openapi-ts": "0.99.0",
    "@japa/api-client": "3.2.1",
    "@japa/assert": "4.2.0",
    "@japa/browser-client": "2.3.0",
    "@japa/plugin-adonisjs": "5.2.0",
    "@japa/runner": "5.3.0",
    "@poppinss/ts-exec": "1.4.4",
    "@types/bun": "1.3.14",
    "@types/luxon": "3.7.1",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@types/sinon": "22.0.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.4.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "hot-hook": "1.0.0",
    "pino-pretty": "13.1.3",
    "portless": "0.15.5",
    "prettier": "3.8.3",
    "sinon": "22.1.0",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "youch": "4.1.1"
  },
  "dependencies": {
    "@adonisjs/auth": "10.1.0",
    "@adonisjs/cache": "2.1.0",
    "@adonisjs/core": "7.3.3",
    "@adonisjs/cors": "3.0.0",
    "@adonisjs/inertia": "5.0.1",
    "@adonisjs/lucid": "22.4.2",
    "@adonisjs/session": "8.1.0",
    "@adonisjs/shield": "9.0.0",
    "@adonisjs/static": "2.0.1",
    "@adonisjs/vite": "6.0.1",
    "@base-ui/react": "1.6.0",
    "@fontsource-variable/inter": "5.3.0",
    "@inertiajs/react": "3.7.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.101.4",
    "@tuyau/core": "1.2.2",
    "@tuyau/react-query": "1.1.0",
    "@vinejs/vine": "4.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dayjs": "1.11.21",
    "edge.js": "6.5.1",
    "lucide-react": "1.25.0",
    "luxon": "3.7.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "reflect-metadata": "0.2.2",
    "shadcn": "4.14.0",
    "sonner": "2.0.7",
    "sqlite3": "6.0.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "overrides": {
    "eslint-plugin-react>eslint": "$eslint"
  }
}
