<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="icon" type="image/svg+xml" media="(prefers-color-scheme: dark)" href="/favicon-dark.svg">
    <link rel="icon" type="image/svg+xml" media="(prefers-color-scheme: light)" href="/favicon-light.svg">

    <link rel="apple-touch-icon" href="/64.png">
    <link rel="apple-touch-icon" sizes="152x152" href="/152.png">
    <link rel="apple-touch-icon" sizes="167x167" href="/167.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/180.png">

    <title inertia>
      Watch Wise
    </title>

    @viteReactRefresh()
    @vite(['inertia/app.tsx'])
    @inertiaHead()
    @stack('dumper')
  </head>

  <body>
    @inertia()
  </body>

</html>
